GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
CANDIDATE_LIMIT=20
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_S=30

# --- API deployment (Railway) ---
# Origins allowed to call the API, comma-separated (your Vercel URL). Unset = localhost only (development).
ALLOWED_ORIGINS=
# Optional regex for extra origins, e.g. Vercel preview deployments
ALLOWED_ORIGIN_REGEX=
# Per-client limit on /api/recommend (each search can cost a Groq call)
RATE_LIMIT=10/minute
# Proxies in front of the app that append to X-Forwarded-For (Railway: 1)
TRUSTED_PROXY_HOPS=1
